# Django Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
DJANGO_INTERNAL_API_URL=http://localhost:8000/api/v1

# ISR Revalidation Secret (shared between Django webhook & Next.js /api/revalidate)
NEXTJS_REVALIDATE_SECRET=dev-revalidation-secret-key-bangla-community-2026

# Site Public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Client ID (optional for Google One-Tap/Login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
