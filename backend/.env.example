# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-community-platform-dev-secret-key-9876543210
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TIME_ZONE=Asia/Dhaka
LANGUAGE_CODE=bn

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/community_db
POSTGRES_DB=community_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Community Verification & Interaction Settings
REQUIRE_VERIFIED_TO_INTERACT=True
EMAIL_VERIFICATION_REQUIRED_TO_INTERACT=True
REGISTRATION_NO_REGEX=^[A-Za-z0-9_\-\.\/]{1,50}$

# Email / SMTP Settings (Console for local dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="নিজের বলার মতো একটা গল্প" <no-reply@community.org>

# Google OAuth2
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com

# S3 / Cloudflare R2 Uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=community-media
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Frontend & Next.js ISR Revalidation
SITE_BASE_URL=http://localhost:3000
NEXTJS_REVALIDATE_URL=http://localhost:3000/api/revalidate
NEXTJS_REVALIDATE_SECRET=change-this-revalidation-secret-key
PUBLIC_SESSIONS_ENABLED=True

# Sentry
SENTRY_DSN=
